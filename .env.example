# Shared local development environment variables.
# Copy to .env in the repo root (consumed by packages/db) and to apps/api/.env as needed.

DATABASE_URL="postgresql://flare:flare_dev_password@localhost:5432/flare_dev?schema=public"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

API_PORT=4000
WEB_PUBLIC_API_URL="http://localhost:4000/v1"
